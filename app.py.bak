# ============================================================
# Application paths
# ============================================================

def get_base_dir() -> Path:
    """
    Return the directory containing application resources.

    During normal Python execution this is the project folder.

    Later, when we package the application as a Windows EXE,
    PyInstaller may provide the temporary resource directory
    through sys._MEIPASS.
    """

    if getattr(sys, "frozen", False):
        return Path(sys._MEIPASS)

    return Path(__file__).resolve().parent


BASE_DIR = get_base_dir()


# ============================================================
# Flask application
# ============================================================

app = Flask(
    __name__,
    template_folder=str(BASE_DIR / "web" / "templates"),
    static_folder=str(BASE_DIR / "web" / "static"),
)


# ============================================================
# Utility functions
# ============================================================

def find_project_file(filename: str):
    """
    Find a project data file.

    Lesson 1 projects may currently have the JSON files either
    directly in the project directory or inside a data folder.

    Supporting both layouts avoids changing our validated
    Lesson 1 structure.
    """

    candidates = [BASE_DIR / filename, BASE_DIR / "data" / filename,]

    for candidate in candidates:
        if candidate.exists():
            return candidate

    return None


def load_json_file(filename: str):
    """
    Load and return JSON data.

    Raises FileNotFoundError if the requested project file
    cannot be located.
    """

    path = find_project_file(filename)

    if path is None:
        raise FileNotFoundError(filename)

    with path.open("r", encoding="utf-8") as file:
        return json.load(file)

def extract_modules(module_data):
    """
    Return the actual list of module records from modules.json.

    Supported formats:

        {
            "portfolio_version": "...",
            "modules": [...]
        }

    or simply:

        [...]
    """

    if isinstance(module_data, list):
        return module_data


    if isinstance(module_data, dict):
        modules = module_data.get("modules")

        if isinstance(modules, list):
            return modules

        if isinstance(modules, dict):
            return list(modules.values())

    raise ValueError("modules.json does not contain a valid module collection")
    
    
    
def normalize_live_question(raw_question,step_number):
    """
    Convert the current QuestionSession question into the
    small, stable structure expected by the browser.
    """

    if not isinstance(raw_question,dict):
        raise ValueError("QuestionSession returned an invalid question")

    question_id = first_present(raw_question,"id","question_id","key","code")

    if question_id is None:
        question_id = (f"step_{step_number}")

    question_text = first_present(raw_question,"text", "question", "prompt","label", "title")

    if question_text is None:
        raise ValueError("Current question has no display text")

    question_type = first_present(raw_question, "type", "question_type","input_type")

    if question_type is None:
        question_type = "single_choice"

    raw_options = first_present(raw_question,"options","choices","answers","responses" )

    normalized_options = []

    # --------------------------------------------------------
    # Dictionary options
    # --------------------------------------------------------
    if isinstance(raw_options,dict):
        for (option_key, option_value) in raw_options.items():
            option = normalize_option(option_value, option_key,dictionary_key=option_key)

            normalized_options.append({
                    "label": option["label"],
                    "value": option["value"],
                }
            )


    # --------------------------------------------------------
    # List options
    # --------------------------------------------------------

    elif isinstance(raw_options, list):
        for (option_index, raw_option) in enumerate(raw_options):
            option = normalize_option(raw_option, option_index)
            normalized_options.append(
                {
                    "label": option["label"],
                    "value":option["value"],
                }
            )


    # --------------------------------------------------------
    # A yes/no question may not explicitly define options.
    # QuestionSession already understands yes/no strings.
    # --------------------------------------------------------

    type_name = str(question_type).lower()

    if (not normalized_options and type_name in ("yes_no", "yesno", "boolean", "bool")):
        normalized_options = [
            {
                "label": "Yes",
                "value": "yes",
            },
            {
                "label": "No",
                "value": "no",
            },
        ]

    if not normalized_options:
        raise ValueError("Current question has no selectable options")

    return {
        "id": str(question_id),
        "text": str(question_text),
        "type": str(question_type),
        "options": normalized_options,
    }
    
# ============================================================
# Lesson 2D - Sales presentation helpers
# ============================================================

def to_text_list(value):
    """
    Convert an optional result field into a clean list of
    strings suitable for presentation.
    """

    if value is None:
        return []


    if isinstance(value,(list,tuple,set)):

        result = []

        for item in value:
            if (item is None or item == "" ):
                continue


            if isinstance(item, dict):
                text = first_present(item, "text", "label", "reason", "message", "name")
                if text is not None:
                    result.append(str(text))
            else:
                result.append(str(item))
        return result

    if isinstance(value, dict):
        result = []
        for (key, item) in value.items():
            if item in (None, "", False):
                continue

            if item is True:
                result.append(str(key))
            else:
                result.append(f"{key}: {item}")
        return result

    return [str(value)]


def pretty_token(value):
    """
    Convert internal tokens such as:

        wifi6_bluetooth

    into:

        Wifi6 Bluetooth
    """

    if value is None:
        return ""

    text = str(value)
    text = text.replace("_", " ")
    text = text.replace("-", " ")

    return " ".join(word.capitalize() for word in text.split())


def get_module_identifier(module):
    """
    Return a module's stable identifier using several
    common portfolio field names.
    """

    if not isinstance(module, dict):
        return None

    return first_present(module, "module_id", "id", "part_number", "part_no", "code" )


def find_module_record(modules, module_id):
    """
    Locate the actual modules.json record corresponding
    to a selection-engine result.
    """

    if module_id is None:
        return None

    wanted = str(module_id).strip().lower()

    for module in modules:
        current_id = (get_module_identifier(module))

        if current_id is None:
            continue

        if (str(current_id).strip().lower()== wanted):
            return module

    return None


def build_capability_chips(module):
    """
    Build short, salesperson-friendly capability badges.

    Missing fields are simply ignored, so this function
    remains compatible as modules.json evolves.
    """

    if not isinstance(module, dict):
        return []
    chips = []

    # --------------------------------------------------------
    # Wi-Fi generation / capability
    # --------------------------------------------------------

    wifi_standard = first_present(module, "wifi_generation", "wifi_standard", "wifi_version")

    if wifi_standard:
        text = str(wifi_standard)

        if "wifi" not in text.lower():
            text = ("Wi-Fi "+ text)

        chips.append(text)

    elif (module.get("wifi") is True):
        chips.append("Wi-Fi")


    # --------------------------------------------------------
    # Bluetooth Low Energy
    # --------------------------------------------------------

    if (module.get("ble") is True):
        chips.append("BLE")


    # --------------------------------------------------------
    # Bluetooth Classic
    # --------------------------------------------------------

    if (module.get("bluetooth_classic") is True):

        chips.append("Bluetooth Classic")

    # --------------------------------------------------------
    # Module family
    # --------------------------------------------------------

    family = first_present(module, "family", "module_family")
    if family:
        chips.append("Family: " + pretty_token(family))


    # --------------------------------------------------------
    # Host interfaces, when available
    # --------------------------------------------------------

    interfaces = first_present(module, "host_interfaces", "interfaces", "host_interface")
    if isinstance(interfaces, list):
        for interface in interfaces:
            chips.append(str(interface))
    elif isinstance(interfaces, str):
        chips.append(interfaces)

    # Remove duplicate labels while preserving order.
    unique = []
    seen = set()
    for chip in chips:
        key = (chip.strip().lower())
        if key in seen:
            continue
        seen.add(key)
        unique.append(chip)
    return unique[:8]


def build_sales_view(decision, recommendation, top_candidate, ranked_results, modules):
    """
    Convert the engineering-oriented selection result into
    a presentation model for Sales and Marketing.

    IMPORTANT:
    This function does NOT select or rank modules.
    It only explains the result already produced by
    evaluate_portfolio().
    """

    candidate = (recommendation or top_candidate)


    # --------------------------------------------------------
    # No candidate at all
    # --------------------------------------------------------

    if candidate is None:
        return {
            "outcome": {
                "code": "no_suitable_module",
                "label": "No Suitable Module",
                "headline": "No current Unisem module matches the captured requirement",
                "summary": "Review the customer requirement "
                    "or discuss the opportunity with "
                    "the product team.",
            },
            "module": None,
            "why_this_module": [],
            "clarifications": [],
            "conflicts": [],
            "preference_notes": [],
            "next_action": (
                "Escalate the requirement for technical review."
            ),
            "alternatives": [],
        }

    module_id = first_present(candidate, "module_id", "id", "part_number", "part_no")
    module_record = (find_module_record(modules, module_id))
    module_name = first_present(candidate, "module_name", "name", "marketing_name")
    if (module_name is None and module_record):
        module_name = first_present(module_record, "module_name", "name", "marketing_name", "product_name" )
    description = None
    if module_record:
        description = first_present(module_record, "short_description", "description", "marketing_description")
    choose_when = first_present(candidate, "choose_when", "recommended_for", "positioning")
    if (choose_when is None and module_record):
        choose_when = first_present(module_record, "choose_when", "recommended_for", "positioning")

    why_this_module = (to_text_list(first_present(candidate, "passed_requirements", "matched_requirements",
                "requirements_satisfied")))

    clarifications = (to_text_list(first_present(candidate, "clarifications", "clarification_items", "questions")))

    conflicts = (to_text_list(first_present(candidate,"hard_failures", "conflicts", "failed_requirements")))

    preference_notes = (to_text_list(first_present(candidate, "preference_notes", "notes", "soft_matches")))
    # --------------------------------------------------------
    # Outcome wording
    # --------------------------------------------------------
    if decision == "recommended":
        outcome = {
            "code": "recommended",
            "label": "Recommended",
            "headline": "Best fit for the captured "
                "customer requirement",
            "summary": "The recommendation engine found "
                "this module compatible with the "
                "requirements captured in the "
                "Sales Wizard.",
        }

        module_role = ("Recommended Module")
        next_action = (
            "Use this module as the primary "
            "recommendation and proceed to "
            "technical discussion or customer "
            "proposal."
        )
    elif (decision == "clarification_required"):
        outcome = {
            "code": "clarification_required",
            "label": "Needs Clarification",
            "headline":
                "A strong candidate exists, but "
                "additional customer information "
                "is required",
            "summary":
                "Resolve the highlighted points "
                "before presenting this module as "
                "a confirmed recommendation.",
        }

        module_role = ("Leading Candidate")
        next_action = ("Confirm the clarification items "
            "with the customer and rerun the "
            "Sales Wizard."
        )
    else:
        outcome = {
            "code": "no_suitable_module",
            "label": "No Suitable Module",
            "headline":
                "No current module fully satisfies "
                "the captured requirement",
            "summary":
                "The closest evaluated candidate is "
                "shown for technical reference only.",
       }

        module_role = ("Closest Evaluated Candidate" )
        next_action = (
            "Review the conflicts with the "
            "customer or escalate the requirement "
            "to the product team."
        )


    # --------------------------------------------------------
    # Ranked alternatives
    # --------------------------------------------------------

    alternatives = []
    for result in ranked_results[1:4]:
        alternative_id = (first_present(result, "module_id", "id", "part_number"))
        if alternative_id is None:
            continue
        alternative_record = (find_module_record(modules,alternative_id ))
        alternative_name = (first_present(result, "module_name", "name"))
        if (alternative_name is None and alternative_record):
            alternative_name = (first_present(alternative_record, "module_name", "name", "product_name"))

        alternatives.append({"module_id": str(alternative_id),
                "module_name": (str(alternative_name) if alternative_name else "" ),
                "status": str(result.get("status", "")),
                "choose_when": str(first_present(result, "choose_when","recommended_for") or ""),
            }
        )


    return {
        "outcome": outcome,
        "module": {
            "role": module_role,
            "module_id": str(module_id or "Unknown"),
            "module_name": str(module_name or ""),
            "description": str(description or ""),
            "choose_when": str(choose_when or ""),
            "capabilities": build_capability_chips(module_record),
        },
        "why_this_module": why_this_module,
        "clarifications": clarifications,
        "conflicts":  conflicts,
        "preference_notes": preference_notes,
        "next_action": next_action,
        "alternatives": alternatives,
    }    
    
def build_recommendation_result(
    requirement,
):
    """
    Evaluate the completed customer requirement against
    the Unisem module portfolio.

    Lesson 2D additionally creates a salesperson-friendly
    presentation model without changing selection logic.
    """

    module_data = load_json_file(
        "modules.json"
    )


    modules = extract_modules(
        module_data
    )


    # --------------------------------------------------------
    # Lesson 1 selection engine
    # --------------------------------------------------------

    results = evaluate_portfolio(
        requirement,
        modules,
    )


    requirement_summary = (
        summarize_requirement(
            requirement
        )
    )


    top_candidate = (
        results[0]
        if results
        else None
    )


    recommendation = None


    # --------------------------------------------------------
    # Preserve Lesson 2C decision rules
    # --------------------------------------------------------

    if top_candidate is None:

        decision = (
            "no_suitable_module"
        )


    elif (
        top_candidate.get(
            "status"
        )
        == "COMPATIBLE"
    ):

        decision = (
            "recommended"
        )


        recommendation = (
            top_candidate
        )


    elif (
        top_candidate.get(
            "status"
        )
        == "NEEDS_CLARIFICATION"
    ):

        decision = (
            "clarification_required"
        )


    else:

        decision = (
            "no_suitable_module"
        )


    # --------------------------------------------------------
    # Lesson 2D presentation adapter
    # --------------------------------------------------------

    sales_view = (
        build_sales_view(
            decision=
                decision,

            recommendation=
                recommendation,

            top_candidate=
                top_candidate,

            ranked_results=
                results,

            modules=
                modules,
        )
    )


    return {
        "state":
            "complete",

        "decision":
            decision,

        "requirement":
            requirement,

        "requirement_summary":
            requirement_summary,

        "recommendation":
            recommendation,

        "top_candidate":
            top_candidate,

        "ranked_results":
            results,

        "sales_view":
            sales_view,
    }
# ============================================================
# Question-tree normalization
# ============================================================

def first_present(mapping, *keys):
    """
    Return the first non-empty value found using the
    supplied keys.
    """

    if not isinstance(mapping, dict):
        return None

    for key in keys:
        if key in mapping:
            value = mapping[key]
            if value is not None and value != "":
                return value
    return None


def normalize_option(raw_option, fallback_value, dictionary_key=None,):
    """
    Convert one question option into a consistent structure
    for the browser.

    Browser format:

        {
            "label": "...",
            "value": "...",
            "next_question_id": "..."
        }
    """

    # --------------------------------------------------------
    # Dictionary-style option
    # --------------------------------------------------------

    if isinstance(raw_option, dict):

        label = first_present(raw_option, "label", "text", "name", "title", "display")
        value = first_present(raw_option, "value", "id", "key", "code")
        next_question = first_present(raw_option, "next", "next_question", "next_question_id", "next_id", "goto", "target" )

        if label is None:
            label = dictionary_key

        if label is None:
            label = value

        if label is None:
            label = str(fallback_value)

        if value is None:
            value = dictionary_key

        if value is None:
            value = label

        return {"label": str(label), "value": value, "next_question_id": (str(next_question) if next_question is not None else None)}


    # --------------------------------------------------------
    # Simple string / number option
    # --------------------------------------------------------

    if dictionary_key is not None:

        return {"label": str(dictionary_key), "value": dictionary_key, "next_question_id": (str(raw_option) if raw_option is not None else None)}


    return {"label": str(raw_option), "value": raw_option, "next_question_id": None}


def normalize_question_tree(raw_tree):
    """
    Convert question_tree.json into a predictable structure
    for the web browser.

    This function intentionally supports several common JSON
    naming conventions so that the browser UI is isolated from
    the storage format used by Lesson 1.
    """

    if not isinstance(raw_tree, dict):

        raise ValueError("question_tree.json must contain a JSON object")


    # --------------------------------------------------------
    # Locate the question collection
    # --------------------------------------------------------

    raw_questions = first_present(raw_tree, "questions", "question_tree", "nodes", "steps")


    # --------------------------------------------------------
    # Fallback:
    # The root itself may contain q1, q2, q3...
    # --------------------------------------------------------

    if raw_questions is None:
        possible_questions = {}
        for key, value in raw_tree.items():
            if not isinstance(value, dict):
                continue

            if any(field in value for field in ("text", "question", "prompt", "options", "choices", "answers")):
                possible_questions[key] = value

        if possible_questions:
            raw_questions = possible_questions

    if raw_questions is None:
        raise ValueError("Unable to locate questions in question_tree.json")

    normalized_questions = []


    # --------------------------------------------------------
    # Dictionary:
    #
    # "questions": {
    #     "q1": {...},
    #     "q2": {...}
    # }
    # --------------------------------------------------------

    if isinstance(raw_questions, dict):

        question_items = list(raw_questions.items())


    # --------------------------------------------------------
    # List:
    #
    # "questions": [
    #     {"id": "q1", ...},
    #     {"id": "q2", ...}
    # ]
    # --------------------------------------------------------

    elif isinstance(raw_questions, list):

        question_items = []
        for index, question in enumerate(raw_questions):
            question_items.append((str(index + 1), question,))
    else:
        raise ValueError("Questions must be stored as a dictionary or list")


    # --------------------------------------------------------
    # Normalize each question
    # --------------------------------------------------------

    for index, (dictionary_question_id, raw_question,) in enumerate(question_items):
        if not isinstance(raw_question, dict):
            continue

        question_id = first_present(raw_question, "id", "question_id", "key", "code")
        if question_id is None:
            question_id = dictionary_question_id

        question_text = first_present(raw_question, "text", "question", "prompt", "label", "title")

        if question_text is None:
            question_text = (f"Question {index + 1}")

        question_type = first_present(raw_question, "type", "question_type", "input_type")

        if question_type is None:
            question_type = "single_choice"
        raw_options = first_present(raw_question, "options", "choices", "answers", "responses")

        question_default_next = first_present(raw_question, "next", "next_question", "next_question_id", "next_id")
        normalized_options = []


        # ----------------------------------------------------
        # Options stored as dictionary
        # ----------------------------------------------------

        if isinstance(raw_options, dict):

            for option_key, option_value in (raw_options.items()):
                option = normalize_option(option_value, option_key, dictionary_key=option_key,)
                if (option["next_question_id"] is None and question_default_next is not None):
                    option["next_question_id"] = str(question_default_next)
                normalized_options.append(option)


        # ----------------------------------------------------
        # Options stored as list
        # ----------------------------------------------------
        elif isinstance(raw_options, list):
            for option_index, raw_option in (enumerate(raw_options)):
                option = normalize_option(raw_option, option_index,)
                if (option["next_question_id"] is None and question_default_next is not None):
                    option["next_question_id"] = str(question_default_next)
                normalized_options.append(option)


        normalized_questions.append(
            {
                "id": str(question_id),
                "text": str(question_text),
                "type": str(question_type),
                "options": normalized_options,
            }
        )


    if not normalized_questions:

        raise ValueError(
            "No usable questions were found"
        )


    # --------------------------------------------------------
    # Add sequential fallback navigation.
    #
    # This is used only when the JSON does not explicitly
    # provide branching information.
    # --------------------------------------------------------

    for index, question in enumerate(normalized_questions):
        if index + 1 < len(normalized_questions):
            fallback_next = (normalized_questions[index + 1]["id"])
        else:
            fallback_next = None
        for option in question["options"]:
            if option["next_question_id"] is None:
                option["next_question_id"] = fallback_next


    # --------------------------------------------------------
    # Determine starting question
    # --------------------------------------------------------

    start_question = first_present(raw_tree, "start_question", "start_question_id", "start", "root", "first_question", "entry")
    if start_question is None:
        start_question = (normalized_questions[0]["id"])

    version = first_present(raw_tree, "version", "question_tree_version", "revision" )
    return {"version": version, "start_question_id": str(start_question), "questions": normalized_questions}

# ============================================================
# Browser routes
# ============================================================

@app.get("/")
def home():
    """
    Main browser interface.
    """

    return render_template("index.html")


# ============================================================
# API routes
# ============================================================

@app.get("/api/health")
def api_health():
    """
    Basic health-check endpoint used by the browser.

    The browser calls this endpoint during startup to make
    sure that the local Python application is running.
    """

    modules_file = find_project_file("modules.json")
    question_tree_file = find_project_file("question_tree.json")

    return jsonify(
        {
            "status": "ok",
            "application": "Unisem Offline Marketing Tool",
            "offline": True,
            "lesson": "2A",
            "modules_database": modules_file is not None,
            "question_tree": question_tree_file is not None,
        }
    )


@app.get("/api/system")
def api_system():
    """
    Return basic application/database information.
    """

    result = {
        "modules_available": False,
        "question_tree_available": False,
    }

    modules_file = find_project_file("modules.json")

    if modules_file is not None:
        result["modules_available"] = True

        try:
            data = load_json_file("modules.json")

            if isinstance(data, dict):

                result["portfolio_version"] = (
                    data.get("portfolio_version")
                    or data.get("version")
                    or "unknown"
                )

                modules = data.get("modules")

                if isinstance(modules, list):
                    result["module_count"] = len(modules)

                elif isinstance(modules, dict):
                    result["module_count"] = len(modules)

            elif isinstance(data, list):
                result["module_count"] = len(data)

        except Exception as exc:
            result["modules_error"] = str(exc)

    question_tree_file = find_project_file("question_tree.json")

    if question_tree_file is not None:
        result["question_tree_available"] = True

    return jsonify(result)
    
    
@app.get("/api/question-tree")
def api_question_tree():
    """
    Return a browser-friendly representation of the
    Sales Wizard question tree.

    Important:
    This does NOT execute the recommendation engine.
    It only exposes the questionnaire structure.
    """

    try:

        raw_tree = load_json_file("question_tree.json")
        normalized_tree = (normalize_question_tree(raw_tree))
        return jsonify({"status": "ok", **normalized_tree})

    except FileNotFoundError:
        return jsonify(
            {
                "status": "error",
                "error": (
                    "question_tree.json "
                    "was not found"
                ),
            }
        ), 404


    except Exception as exc:
        return jsonify(
            {
                "status": "error",
                "error": str(exc),
            }
        ), 500

@app.post("/api/wizard")
def api_wizard():
    """
    Replay all answers through the validated Lesson 1
    QuestionSession.

    The endpoint returns either:

        state = "question"

    or:

        state = "complete"

    The browser never decides questionnaire branching.
    """

    try:
        payload = request.get_json(silent=True)
        if payload is None:
            payload = {}

        answers = payload.get("answers", [])
        if not isinstance(answers, list):
            return jsonify(
                {
                    "status": "error",
                    "error": (
                        "'answers' must "
                        "be a JSON list"
                    ),
                }
            ), 400

        tree = load_json_file("question_tree.json")

        # ----------------------------------------------------
        # Create a fresh deterministic engine session.
        # ----------------------------------------------------

        session = QuestionSession(tree)

        # ----------------------------------------------------
        # Replay all customer answers.
        # ----------------------------------------------------

        for (answer_index, answer_value) in enumerate(answers):
            if session.is_complete():
                raise ValueError(
                    "Answers were supplied after "
                    "the questionnaire had already "
                    "completed"
                )
            session.answer(answer_value)
        # ----------------------------------------------------
        # Questionnaire complete
        # ----------------------------------------------------

        if session.is_complete():
            requirement = (session.get_requirement())
            result = (build_recommendation_result(requirement))
            return jsonify(
                {
                    "status": "ok",
                    **result,
                }
            )

        # ----------------------------------------------------
        # Questionnaire still active
        # ----------------------------------------------------

        current_question = (session.get_current_question())
        browser_question = (normalize_live_question(current_question,len(answers) + 1))

        return jsonify(
            {
                "status": "ok",
                "state": "question",
                "step": len(answers) + 1,
                "question": browser_question,
            }
        )

    except FileNotFoundError as exc:
        return jsonify(
            {
                "status": "error",
                "error": (
                    "Required project file "
                    f"not found: {exc}"
                ),
            }
        ), 500

    except (QuestionTreeError, ValueError, TypeError, KeyError) as exc:
        return jsonify(
            {
                "status": "error",
                "error": str(exc),
            }
        ), 400


    except Exception as exc:
        print("Unexpected wizard error:", repr(exc))
        return jsonify(
            {
                "status": "error",
                "error": (
                    "The recommendation engine "
                    "encountered an unexpected error"
                ),
            }
        ), 500
# ============================================================
# Application entry point
# ============================================================

if __name__ == "__main__":

    print()
    print("=====================================================")
    print(" UNISEM OFFLINE MARKETING TOOL")
    print("=====================================================")
    print()
    print("Local application starting...")
    print()
    print("Open your browser at:")
    print()
    print("    http://127.0.0.1:5000")
    print()

    app.run(
        host="127.0.0.1",
        port=5000,
        debug=False,
    )