<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Unisem Module Selector</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/style.css') }}"
    >
</head>


<body>

    <header class="top-header">

        <div class="brand">
            <div class="brand-name">
                UNISEM
            </div>

            <div class="brand-subtitle">
                Module Marketing Tools
            </div>
        </div>

        <div class="offline-badge">
            OFFLINE
        </div>

    </header>


    <main class="main-container">

        <section class="hero">

            <p class="eyebrow">
                SALES & MARKETING ASSISTANT
            </p>

            <h1>
                Find the right Unisem wireless module
            </h1>

            <p class="hero-text">
                Answer a few customer requirement questions
                and the tool will guide you toward the most
                suitable Unisem module.
            </p>

            <button
                id="startWizardButton"
                class="primary-button"
                type="button"
            >
                Start Sales Wizard
            </button>

        </section>


        <section class="status-panel">

            <h2>
                Application Status
            </h2>


            <div class="status-grid">

                <div class="status-card">

                    <span class="status-label">
                        Application
                    </span>

                    <span
                        id="backendStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Module Portfolio
                    </span>

                    <span
                        id="moduleStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Sales Question Tree
                    </span>

                    <span
                        id="questionTreeStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Operating Mode
                    </span>

                    <span
                        id="offlineStatus"
                        class="status-value"
                    >
                        Local / Offline
                    </span>

                </div>

            </div>

        </section>


        <section
    id="wizardPanel"
    class="wizard-panel hidden"
>

    <div class="wizard-header">

        <div>

            <p class="eyebrow">
                CUSTOMER REQUIREMENTS
            </p>

            <h2>
                Sales Wizard
            </h2>

        </div>


        <div
            id="progressText"
            class="progress-text"
        >
        </div>

    </div>


    <div
        id="wizardError"
        class="wizard-error hidden"
    >
    </div>


    <div
        id="questionArea"
    >

        <p
            id="questionId"
            class="question-id"
        >
        </p>

        <h3
            id="questionText"
            class="question-text"
        >
        </h3>


        <div
            id="optionsContainer"
            class="options-container"
        >
        </div>
		
		<div
			id="questionActions"
			class="question-actions hidden"
		>
		</div>

    </div>


    <div
    id="wizardComplete"
    class="wizard-complete hidden"
>

    <div class="complete-icon">
        ✓
    </div>


    <h3 id="completionTitle">
        Requirement evaluation complete
    </h3>


    <p id="completionMessage">
        The Unisem recommendation engine has
        evaluated the customer requirements.
    </p>


    <div
        id="answerSummary"
        class="answer-summary"
    >
    </div>


    <div
    id="recommendationPanel"
    class="recommendation-panel hidden"
>

    <div class="result-top-row">

        <div>

            <p
                id="moduleRole"
                class="result-eyebrow"
            >
            </p>

            <div
                id="decisionBadge"
                class="decision-badge"
            >
            </div>

        </div>

    </div>


    <h3
        id="recommendedModule"
        class="recommended-module"
    >
    </h3>


    <p
        id="recommendedModuleName"
        class="recommended-module-name"
    >
    </p>


    <p
        id="moduleDescription"
        class="module-description hidden"
    >
    </p>


    <h4
        id="resultHeadline"
        class="result-headline"
    >
    </h4>


    <p
        id="resultSummary"
        class="result-summary"
    >
    </p>


    <div
        id="capabilityChips"
        class="capability-chips"
    >
    </div>


    <section
        id="chooseWhenSection"
        class="result-section hidden"
    >

        <h4>
            When to position this module
        </h4>

        <p id="chooseWhen">
        </p>

    </section>


    <section
        id="whySection"
        class="result-section hidden"
    >

        <h4>
            Why this module?
        </h4>

        <ul
            id="whyList"
            class="result-list positive-list"
        >
        </ul>

    </section>


    <section
        id="clarificationSection"
        class="result-section attention-section hidden"
    >

        <h4>
            Clarifications to confirm
        </h4>

        <ul
            id="clarificationList"
            class="result-list"
        >
        </ul>

    </section>


    <section
        id="conflictSection"
        class="result-section conflict-section hidden"
    >

        <h4>
            Requirement conflicts
        </h4>

        <ul
            id="conflictList"
            class="result-list"
        >
        </ul>

    </section>


    <section
        id="preferenceSection"
        class="result-section hidden"
    >

        <h4>
            Additional fit notes
        </h4>

        <ul
            id="preferenceList"
            class="result-list"
        >
        </ul>

    </section>


    <section class="next-action-card">

        <span class="next-action-label">
            Recommended next action
        </span>

        <p id="nextAction">
        </p>

    </section>


    <section
        id="alternativesSection"
        class="result-section hidden"
    >

        <h4>
            Other evaluated modules
        </h4>

        <div
            id="alternativesContainer"
            class="alternatives-container"
        >
        </div>

    </section>

</div>

        <div
            id="decisionBadge"
            class="decision-badge"
        >
        </div>


        <h3
            id="recommendedModule"
            class="recommended-module"
        >
        </h3>


        <p
            id="recommendedModuleName"
            class="recommended-module-name"
        >
        </p>


        <p
            id="chooseWhen"
            class="choose-when"
        >
        </p>


        <div
            id="recommendationDetails"
            class="recommendation-details"
        >
        </div>

    </div>

</div>

</section>

    </main>


    <footer>

        Unisem Module Marketing Tools

    </footer>


    <script
        src="{{ url_for('static', filename='js/app.js') }}"
    ></script>

</body>

</html>