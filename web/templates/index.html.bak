<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Unisem Module Selector</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/style.css') }}"
    >
</head>


<body>

    <header class="top-header">

        <div class="brand">
            <div class="brand-name">
                UNISEM
            </div>

            <div class="brand-subtitle">
                Module Marketing Tools
            </div>
        </div>

        <div class="offline-badge">
            OFFLINE
        </div>

    </header>


    <main class="main-container">

        <section class="hero">

            <p class="eyebrow">
                SALES & MARKETING ASSISTANT
            </p>

            <h1>
                Find the right Unisem wireless module
            </h1>

            <p class="hero-text">
                Answer a few customer requirement questions
                and the tool will guide you toward the most
                suitable Unisem module.
            </p>

            <button
                id="startWizardButton"
                class="primary-button"
                type="button"
            >
                Start Sales Wizard
            </button>

        </section>


        <section class="status-panel">

            <h2>
                Application Status
            </h2>


            <div class="status-grid">

                <div class="status-card">

                    <span class="status-label">
                        Application
                    </span>

                    <span
                        id="backendStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Module Portfolio
                    </span>

                    <span
                        id="moduleStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Sales Question Tree
                    </span>

                    <span
                        id="questionTreeStatus"
                        class="status-value pending"
                    >
                        Checking...
                    </span>

                </div>


                <div class="status-card">

                    <span class="status-label">
                        Operating Mode
                    </span>

                    <span
                        id="offlineStatus"
                        class="status-value"
                    >
                        Local / Offline
                    </span>

                </div>

            </div>

        </section>


        <section
    id="wizardPanel"
    class="wizard-panel hidden"
>

    <div class="wizard-header">

        <div>

            <p class="eyebrow">
                CUSTOMER REQUIREMENTS
            </p>

            <h2>
                Sales Wizard
            </h2>

        </div>


        <div
            id="progressText"
            class="progress-text"
        >
        </div>

    </div>


    <div
        id="wizardError"
        class="wizard-error hidden"
    >
    </div>


    <div
        id="questionArea"
    >

        <p
            id="questionId"
            class="question-id"
        >
        </p>

        <h3
            id="questionText"
            class="question-text"
        >
        </h3>


        <div
            id="optionsContainer"
            class="options-container"
        >
        </div>

    </div>


    <div
        id="wizardComplete"
        class="wizard-complete hidden"
    >

        <div class="complete-icon">
            ✓
        </div>

        <h3>
            Customer requirements captured
        </h3>

        <p>
            The questionnaire has been completed
            successfully.
        </p>

        <p>
            In Lesson 2C these answers will be sent
            to the validated Unisem recommendation
            engine.
        </p>


        <div
            id="answerSummary"
            class="answer-summary"
        >
        </div>

    </div>

</section>

    </main>


    <footer>

        Unisem Module Marketing Tools

    </footer>


    <script
        src="{{ url_for('static', filename='js/app.js') }}"
    ></script>

</body>

</html>